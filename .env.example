# Copy to .env and fill in values

# Must match ez-prep-api JWT_SECRET. Middleware verifies the admin session JWT.
JWT_SECRET=
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ExamFlex NestJS backend
# Local: http://localhost:3000
# Production: https://api.examflex.in
EZPREP_API_URL=http://localhost:3000
EZPREP_API_PREFIX=/api
